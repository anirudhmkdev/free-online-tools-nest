---
import { SITE } from '../data/tools';
import { useTranslations,getLangFromUrl,localizePath } from '../i18n/utils';
import Icon from './CampusIcon.astro';
const lang=getLangFromUrl(Astro.url), t=useTranslations(lang);
const lh=(p:string)=>localizePath(p,lang);
const links=lang==='en' ? [
  {label:'Student Tools',href:'/student-tools/'}, {label:'Document Tools',href:'/document-tools/'},
  {label:'Writing Tools',href:'/writing-tools/'}, {label:'Workflows',href:'/workflows/'},
  {label:'Guides',href:'/#practical-guides'}, {label:'More Tools',href:'/tools/'}
] : [{label:t('nav.tools'),href:lh('/tools/')},{label:t('nav.categories'),href:lh('/categories/')},{label:t('nav.blog'),href:'/blog/'}];
const primary=links.slice(0,3), browse=lang==='en'?links.slice(3):[];
---
<header class="campus-header" id="campus-header">
  <nav class="campus-nav" aria-label={t('nav.mainNav')}>
    <a href={lh('/')} class="site-brand" aria-label={SITE.name+' '+t('nav.homeLabel')}>Free Online<br /><span>Tools Nest</span></a>
    <div class="campus-wide-nav">
      {primary.map(link=><a href={link.href} aria-current={Astro.url.pathname===link.href?'page':undefined}>{link.label}</a>)}
      {browse.length>0 && <>
        <button id="browse-trigger" popovertarget="campus-browse" type="button" aria-expanded="false">Browse <Icon name="chevron" /></button>
        <div popover="auto" id="campus-browse" class="campus-browse" aria-label="Browse more tools and content">
          {browse.map(link=><a href={link.href}>{link.label}<Icon name="arrow" /></a>)}
        </div>
      </>}
    </div>
    <div class="campus-nav-actions">
      <button type="button" id="cmd-k-trigger" class="nav-button" aria-label={t('nav.search')}><Icon name="search" /></button>
      <button type="button" id="theme-toggle" class="nav-button" aria-label={t('nav.theme')} aria-pressed="false"><Icon name="theme" /></button>
      <button type="button" id="mobile-menu-btn" class="nav-button campus-menu-trigger" aria-label={t('nav.menu')} aria-controls="mobile-menu" aria-expanded="false"><Icon name="menu" /></button>
    </div>
  </nav>
</header>
<dialog id="mobile-menu" class="campus-drawer" aria-label={t('nav.mobileNav')}>
  <div class="campus-menu-heading"><h2>{t('nav.navigation')}</h2><button id="mobile-menu-close" type="button" class="nav-button" aria-label={t('nav.closeMenu')} autofocus><Icon name="close" /></button></div>
  <nav class="campus-mobile-links" aria-label={t('nav.mobileNav')}>
    {links.map(link=><a href={link.href} aria-current={Astro.url.pathname===link.href?'page':undefined}>{link.label}<Icon name="arrow" /></a>)}
    <hr />
    <a href={lh('/about/')}>{t('nav.about')}</a>
    <a href={lh('/standards/')}>{t('footer.standards')}</a>
    <a href={lh('/contact/')}>{t('nav.contact')}</a>
    <button type="button" data-open-cmdk>{t('nav.search')}<Icon name="search" /></button>
  </nav>
</dialog>
<noscript><nav class="campus-static-nav container-page" aria-label={t('nav.mainNav')}>{links.map(link=><a href={link.href}>{link.label}</a>)}</nav></noscript>
<script>
  const header=document.getElementById('campus-header')!;
  const drawer=document.getElementById('mobile-menu') as HTMLDialogElement;
  const trigger=document.getElementById('mobile-menu-btn') as HTMLButtonElement;
  const browse=document.getElementById('campus-browse');
  const browseTrigger=document.getElementById('browse-trigger');
  let oldOverflow='';
  const measure=()=>{
    const rect=header.getBoundingClientRect();
    document.documentElement.style.setProperty('--header-offset',`${rect.height+32}px`);
    if(browse&&browseTrigger){ const r=browseTrigger.getBoundingClientRect(); browse.style.top=`${Math.max(rect.bottom,r.bottom)+8}px`; browse.style.left=`${Math.max(16,Math.min(r.right-360,innerWidth-376))}px`; browse.style.maxHeight=`${Math.max(100,innerHeight-rect.bottom-24)}px`; }
  };
  new ResizeObserver(measure).observe(header);
  window.addEventListener('resize',measure); measure();
  const closeBrowse=()=>{if(browse?.matches(':popover-open')) (browse as HTMLElement).hidePopover();};
  const closeDrawer=()=>{if(drawer.open){document.body.style.overflow=oldOverflow;drawer.close();}};
  trigger.addEventListener('click',()=>{closeBrowse(); oldOverflow=document.body.style.overflow; drawer.showModal(); document.body.style.overflow='hidden'; trigger.setAttribute('aria-expanded','true');});
  drawer.addEventListener('close',()=>{trigger.setAttribute('aria-expanded','false');if(!document.querySelector('dialog[open]')){document.body.style.overflow=oldOverflow;trigger.focus({preventScroll:true});}});
  document.getElementById('mobile-menu-close')?.addEventListener('click',closeDrawer);
  drawer.addEventListener('click',e=>{if(e.target!==drawer)return;const r=drawer.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)closeDrawer();});
  drawer.querySelectorAll('a').forEach(a=>a.addEventListener('click',closeDrawer));
  const openSearch=()=>{closeBrowse();closeDrawer();document.dispatchEvent(new CustomEvent('open-cmdk'));};
  document.getElementById('cmd-k-trigger')?.addEventListener('click',openSearch);
  drawer.querySelector('[data-open-cmdk]')?.addEventListener('click',openSearch);
  document.addEventListener('keydown',e=>{if((e.ctrlKey||e.metaKey)&&e.key==='k'){closeBrowse();closeDrawer();}});
  browse?.addEventListener('toggle',()=>{browseTrigger?.setAttribute('aria-expanded',String(browse.matches(':popover-open')));measure();});
  browse?.querySelectorAll('a').forEach(a=>a.addEventListener('click',closeBrowse));
  const theme=document.getElementById('theme-toggle');
  const syncTheme=()=>{const dark=document.documentElement.classList.contains('dark');theme?.setAttribute('aria-pressed',String(dark));document.querySelector('meta[name="theme-color"]')?.setAttribute('content',dark?'#14234c':'#e8eefb');};
  theme?.addEventListener('click',()=>{const dark=document.documentElement.classList.toggle('dark');try{localStorage.setItem('theme',dark?'dark':'light');}catch{}syncTheme();});syncTheme();
  matchMedia('(min-width:1280px)').addEventListener('change',()=>{closeBrowse();closeDrawer();});
</script>
