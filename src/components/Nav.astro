---
import { SITE } from "../data/tools";
import { useTranslations, getLangFromUrl, localizePath } from "../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const lh = (path: string) => localizePath(path, lang);
const links = lang === "en" ? [
  { label: "Student Tools", href: "/student-tools/" },
  { label: "Document Tools", href: "/document-tools/" },
  { label: "Writing Tools", href: "/writing-tools/" },
  { label: "Workflows", href: "/workflows/" },
  { label: "Guides", href: "/#practical-guides" },
  { label: "More Tools", href: "/tools/" },
] : [
  { label: t("nav.tools"), href: lh("/tools/") },
  { label: t("nav.categories"), href: lh("/categories/") },
  { label: t("nav.blog"), href: "/blog/" },
];
---
<header class="site-header">
  <nav class="container-page nav-row" aria-label={t("nav.mainNav")}>
    <a href={lh("/")} class="site-brand" aria-label={SITE.name + " " + t("nav.homeLabel")}>Free Online<br /><span>Tools Nest</span></a>
    <div class="desktop-links">
      {links.map(link => <a href={link.href} aria-current={Astro.url.pathname === link.href ? "page" : undefined}>{link.label}</a>)}
    </div>
    <div class="nav-actions">
      <button id="cmd-k-trigger" class="nav-button" type="button" aria-label={t("nav.search")}>
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      </button>
      <button id="theme-toggle" class="nav-button" type="button" aria-label={t("nav.theme")}>
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor"/></svg>
      </button>
      <button id="mobile-menu-btn" class="nav-button menu-trigger" type="button" aria-label={t("nav.menu")} aria-controls="mobile-menu" aria-expanded="false">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </nav>
</header>
<dialog id="mobile-menu" aria-label={t("nav.mobileNav")}>
  <div class="menu-heading"><p>{t("nav.navigation")}</p><button id="mobile-menu-close" class="nav-button" type="button" aria-label={t("nav.closeMenu")} autofocus><span aria-hidden="true">✕</span></button></div>
  <nav class="mobile-links" aria-label={t("nav.mobileNav")}>
    {links.map(link => <a href={link.href}>{link.label}</a>)}
    <hr />
    <a href={lh("/about/")}>{t("nav.about")}</a>
    <a href={lh("/standards/")}>{t("footer.standards")}</a>
    <a href={lh("/contact/")}>{t("nav.contact")}</a>
    <button type="button" data-open-cmdk>{t("nav.search")}</button>
  </nav>
</dialog>
<div class="header-spacer" aria-hidden="true"></div>
<style>
  .site-header { position: fixed; inset: 0 0 auto; height: 72px; z-index: 50; border-bottom: 1px solid var(--color-hairline); background: var(--color-canvas); }
  .nav-row { display: flex; align-items: center; justify-content: space-between; gap: 24px; height: 100%; }
  .site-brand { color: var(--color-body); line-height: 1.15; font-size: 11px; font-weight: 500; text-decoration: none; flex-shrink: 0; }
  .site-brand span { color: var(--color-ink); font-size: 22px; font-weight: 600; letter-spacing: -0.6px; }
  .desktop-links { display: none; align-items: center; gap: 4px; }
  .desktop-links a { padding: 10px 12px; font-size: 13px; font-weight: 500; border-radius: 6px; text-decoration: none; color: var(--color-body); white-space: nowrap; }
  .desktop-links a:hover, .desktop-links a[aria-current] { color: var(--color-ink); background: var(--color-canvas-soft-2); }
  .nav-actions { display: flex; align-items: center; gap: 4px; }
  .nav-button { display: inline-flex; width: 44px; height: 44px; align-items: center; justify-content: center; border: 1px solid transparent; border-radius: 8px; background: transparent; color: var(--color-ink); cursor: pointer; }
  .nav-button:hover { background: var(--color-canvas-soft-2); }
  .header-spacer { height: 72px; }
  dialog { width: min(100%, 380px); height: 100dvh; max-height: 100dvh; max-width: 100vw; margin: 0 0 0 auto; padding: 24px; border: 0; border-left: 1px solid var(--color-hairline); background: var(--color-canvas); color: var(--color-ink); }
  dialog::backdrop { background: rgb(0 0 0 / 45%); }
  .menu-heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 24px; font-size: 18px; font-weight: 500; }
  .mobile-links { display: flex; flex-direction: column; gap: 8px; }
  .mobile-links a, .mobile-links button { display: block; padding: 14px 12px; text-align: left; border-radius: 8px; color: var(--color-ink); font-size: 15px; text-decoration: none; border: 0; background: transparent; }
  .mobile-links a:hover, .mobile-links button:hover { background: var(--color-canvas-soft-2); }
  .mobile-links hr { border-color: var(--color-hairline); margin-block: 8px; }
  @media (min-width: 1280px) { .desktop-links { display: flex; } .menu-trigger { display: none; } }
</style>
<script>
  const menu = document.getElementById("mobile-menu") as HTMLDialogElement;
  const trigger = document.getElementById("mobile-menu-btn");
  function closeMenu() { menu?.close(); }
  trigger?.addEventListener("click", () => {
    menu.showModal();
    trigger.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
  });
  menu?.addEventListener("close", () => {
    trigger?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  });
  menu?.addEventListener("keydown", (event) => {
    if (event.key !== "Tab") return;
    const controls = [...menu.querySelectorAll<HTMLElement>("a[href], button:not([disabled])")];
    const first = controls[0];
    const last = controls[controls.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last?.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first?.focus();
    }
  });
  menu?.addEventListener("click", (event) => {
    if (event.target === menu) {
      const bounds = menu.getBoundingClientRect();
      if (event.clientX < bounds.left || event.clientX > bounds.right) closeMenu();
    }
  });
  document.getElementById("mobile-menu-close")?.addEventListener("click", closeMenu);
  menu?.querySelectorAll("a").forEach(link => link.addEventListener("click", closeMenu));
  document.getElementById("cmd-k-trigger")?.addEventListener("click", () => document.dispatchEvent(new CustomEvent("open-cmdk")));
  document.querySelector("[data-open-cmdk]")?.addEventListener("click", () => {
    closeMenu();
    document.dispatchEvent(new CustomEvent("open-cmdk"));
  });
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch { /* Theme works even when storage is unavailable. */ }
  });
  window.matchMedia("(min-width: 1280px)").addEventListener("change", event => {
    if (event.matches && menu?.open) closeMenu();
  });
</script>
