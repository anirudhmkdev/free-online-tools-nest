---
import search from '../assets/campus-icons/magnifying-glass.svg?raw';
import theme from '../assets/campus-icons/circle-half.svg?raw';
import menu from '../assets/campus-icons/list.svg?raw';
import close from '../assets/campus-icons/x.svg?raw';
import chevron from '../assets/campus-icons/caret-down.svg?raw';
import arrow from '../assets/campus-icons/arrow-up-right.svg?raw';
import text from '../assets/campus-icons/text-aa.svg?raw';
import code from '../assets/campus-icons/code.svg?raw';
import file from '../assets/campus-icons/files.svg?raw';
import calculator from '../assets/campus-icons/calculator.svg?raw';
import swap from '../assets/campus-icons/arrows-left-right.svg?raw';
import palette from '../assets/campus-icons/palette.svg?raw';
const icons={search,theme,menu,close,chevron,arrow,text,code,file,calculator,swap,palette};
interface Props { name?:keyof typeof icons }
const {name='file'}=Astro.props;
---
<span class="campus-icon" aria-hidden="true" set:html={icons[name]} />

