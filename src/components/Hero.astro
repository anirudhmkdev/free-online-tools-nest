---
const quickTasks = [
  { label: "Plan your attendance", href: "/tools/attendance-calculator/", note: "Use your required attendance target" },
  { label: "Calculate SGPA", href: "/tools/sgpa-calculator/", note: "Your credits and grade scale" },
  { label: "Turn images into a PDF", href: "/tools/image-to-pdf/", note: "Local JPEG and PNG conversion" },
  { label: "Compress a PDF", href: "/tools/pdf-compressor/", note: "Check the final file size" },
  { label: "Merge PDFs", href: "/tools/pdf-merger/", note: "Combine assignment pages" },
  { label: "Count assignment words", href: "/tools/word-counter/", note: "Check your draft length" },
];
---

<section class="study-hero" aria-labelledby="home-heading">
  <div class="container-page hero-layout">
    <div class="hero-copy">
      <p class="section-eyebrow">Free · No signup · Local tool processing</p>
      <h1 id="home-heading">Free tools for study, assignments and everyday documents</h1>
      <p class="hero-intro">Plan attendance, calculate grades with your own rules, and prepare assignment files directly in your browser.</p>
      <div class="hero-search-wrap">
        <label for="hero-search">What do you need to do?</label>
        <div class="hero-search-field">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          <input id="hero-search" type="search" placeholder="Try attendance, SGPA or PDF…" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="hero-search-results" aria-autocomplete="list" />
        </div>
        <div id="hero-search-results" class="hidden hero-search-results" role="listbox" aria-label="Matching tools"></div>
      </div>
      <div class="hero-actions">
        <a href="#study-assignment-tools" class="btn-primary">Explore student tools</a>
        <a href="/tools/" class="btn-secondary">Find a tool</a>
      </div>
      <p class="hero-privacy">Tool inputs are processed in your browser. <a href="#local-processing">How processing and privacy work</a></p>
    </div>
    <aside class="task-launcher" aria-labelledby="quick-tasks-heading">
      <div class="task-launcher-heading">
        <p class="section-eyebrow">Ready when you are</p>
        <h2 id="quick-tasks-heading">Start with a task</h2>
      </div>
      <ul>
        {quickTasks.map(task => (
          <li><a href={task.href}><span><strong>{task.label}</strong><small>{task.note}</small></span><span aria-hidden="true">↗</span></a></li>
        ))}
      </ul>
      <p class="task-launcher-footer">Your files. Your browser. A little less busywork.</p>
    </aside>
  </div>
</section>

<style>
  .study-hero { padding: 64px 0 56px; background: var(--color-canvas); border-bottom: 1px solid var(--color-hairline); }
  .hero-layout { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(300px, 1fr); gap: 64px; align-items: center; }
  .hero-copy h1 { font-size: clamp(34px, 4vw, 54px); line-height: 1.1; font-weight: 600; letter-spacing: -1.5px; text-wrap: balance; max-width: 700px; }
  .hero-intro { font-size: 18px; line-height: 1.7; color: var(--color-body); margin-top: 22px; max-width: 580px; }
  .hero-search-wrap { margin-top: 28px; position: relative; max-width: 590px; }
  .hero-search-wrap label { display: block; margin-bottom: 10px; font-size: 14px; font-weight: 500; }
  .hero-search-field { display: flex; align-items: center; gap: 12px; border: 1px solid var(--color-hairline-strong); border-radius: 10px; padding: 0 16px; background: var(--color-canvas); }
  .hero-search-field:focus-within { outline: 2px solid var(--color-link); outline-offset: 2px; }
  .hero-search-field svg { flex-shrink: 0; color: var(--color-body); }
  .hero-search-field input { min-width: 0; width: 100%; height: 54px; background: transparent; border: 0; color: var(--color-ink); font-size: 16px; }
  .hero-search-field input:focus-visible { outline: none; }
  .hero-search-results { position: absolute; top: 100%; margin-top: 8px; left: 0; right: 0; z-index: 20; background: var(--color-canvas); border: 1px solid var(--color-hairline); border-radius: 10px; overflow: hidden; box-shadow: var(--shadow-modal); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 22px; }
  .hero-actions a { font-size: 14px; }
  .hero-privacy { margin-top: 20px; font-size: 12px; line-height: 1.7; color: var(--color-body); }
  .hero-privacy a { color: var(--color-link); text-decoration: underline; text-underline-offset: 3px; }
  .task-launcher { border: 1px solid var(--color-hairline); border-radius: 16px; background: var(--color-canvas-soft); overflow: hidden; }
  .task-launcher-heading { padding: 24px 24px 16px; }
  .task-launcher-heading h2 { font-size: 22px; font-weight: 600; }
  .task-launcher-heading .section-eyebrow { margin-bottom: 8px; }
  .task-launcher ul { padding: 0 12px; list-style: none; }
  .task-launcher li + li { border-top: 1px solid var(--color-hairline); }
  .task-launcher li a { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 15px 12px; text-decoration: none; color: var(--color-ink); border-radius: 6px; }
  .task-launcher li a:hover { background: var(--color-canvas-soft-2); }
  .task-launcher strong { display: block; font-size: 14px; font-weight: 500; }
  .task-launcher small { display: block; font-size: 12px; color: var(--color-body); margin-top: 4px; }
  .task-launcher-footer { padding: 18px 24px; font-size: 12px; line-height: 1.6; color: var(--color-body); border-top: 1px solid var(--color-hairline); margin-top: 8px; }
  @media (max-width: 900px) { .hero-layout { grid-template-columns: 1fr; gap: 32px; } .study-hero { padding-top: 36px; } .hero-copy h1 { max-width: 650px; } }
  @media (max-width: 480px) { .hero-actions { flex-direction: column; } .hero-actions a { text-align: center; justify-content: center; white-space: normal; } .hero-copy h1 { letter-spacing: -0.8px; } }
</style>

<script>
  import { findSearchEntries, readSearchEntries } from "../helpers/search";
  import { createSearchResultStatusText } from "../helpers/utils";

  const input = document.getElementById("hero-search") as HTMLInputElement;
  const results = document.getElementById("hero-search-results");
  let activeIndex = -1;
  let activeLinks: HTMLAnchorElement[] = [];

  function clearResults() {
    if (!results) return;
    results.replaceChildren();
    results.classList.add("hidden");
    input?.setAttribute("aria-expanded", "false");
    input?.removeAttribute("aria-activedescendant");
    activeIndex = -1;
    activeLinks = [];
  }

  function setActiveIndex(index: number) {
    activeLinks.forEach((link, i) => {
      const isActive = i === index;
      link.setAttribute("aria-selected", String(isActive));
      link.classList.toggle("bg-canvas-soft-2", isActive);
    });
    activeIndex = index;
    if (activeLinks[index]) {
      input?.setAttribute("aria-activedescendant", activeLinks[index].id);
    } else {
      input?.removeAttribute("aria-activedescendant");
    }
  }

  function renderResults(query: string) {
    if (!results) return;
    const q = query.toLowerCase().trim();
    if (!q) {
      clearResults();
      return;
    }

    const matches = findSearchEntries(readSearchEntries(), q, {
      limit: 5, toolsOnly: true, includeKeywords: true,
    });

    results.replaceChildren();

    if (matches.length === 0) {
      const empty = document.createElement("div");
      empty.className = "px-4 py-3 text-sm text-mute";
      empty.textContent = createSearchResultStatusText(q);
      results.append(empty);
      activeLinks = [];
    } else {
      activeLinks = matches.map((tool, index) => {
        const link = document.createElement("a");
        link.href = tool.url;
        link.id = `hero-search-option-${index}`;
        link.role = "option";
        link.setAttribute("aria-selected", "false");
        link.className = "flex items-center gap-3 px-4 py-3 hover:bg-canvas-soft-2 transition-colors duration-100 no-underline";

        const icon = document.createElement("span");
        icon.className = "text-lg shrink-0";
        icon.textContent = tool.icon;

        const body = document.createElement("div");
        const name = document.createElement("div");
        name.className = "text-sm font-medium text-ink";
        name.textContent = tool.name;
        const description = document.createElement("div");
        description.className = "text-xs text-mute line-clamp-1";
        description.textContent = tool.description;

        body.append(name, description);
        link.append(icon, body);
        return link;
      });
      results.append(...activeLinks);
    }

    results.classList.remove("hidden");
    input?.setAttribute("aria-expanded", "true");
    setActiveIndex(activeLinks.length > 0 ? 0 : -1);
  }

  input?.addEventListener("input", (event) => {
    renderResults((event.target as HTMLInputElement).value);
  });

  document.addEventListener("click", (event) => {
    if (!input?.contains(event.target as Node) && !results?.contains(event.target as Node)) {
      clearResults();
    }
  });

  input?.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      clearResults();
      input.blur();
      return;
    }
    if (results?.classList.contains("hidden") || activeLinks.length === 0) return;
    if (event.key === "ArrowDown") {
      event.preventDefault();
      setActiveIndex((activeIndex + 1) % activeLinks.length);
    } else if (event.key === "ArrowUp") {
      event.preventDefault();
      setActiveIndex((activeIndex - 1 + activeLinks.length) % activeLinks.length);
    } else if (event.key === "Enter" && activeIndex >= 0) {
      event.preventDefault();
      activeLinks[activeIndex].click();
    }
  });
</script>
