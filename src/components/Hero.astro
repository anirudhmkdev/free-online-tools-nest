---
import Icon from './CampusIcon.astro';
import { Image } from 'astro:assets';
import stationery from '../assets/campus-stationery.png';
const quickTasks = [
  { label: "Generate random numbers", href: "/tools/random-number-generator/", note: "Choose your range and count" },
  { label: "Format JSON", href: "/tools/json-formatter/", note: "Validate and format a document" },
  { label: "Compress an image", href: "/tools/image-compressor/", note: "Choose quality and check the result" },
  { label: "Compress a PDF", href: "/tools/pdf-compressor/", note: "Check the final file size" },
  { label: "Merge PDFs", href: "/tools/pdf-merger/", note: "Combine assignment pages" },
  { label: "Count assignment words", href: "/tools/word-counter/", note: "Check your draft length" },
];
---
<section class="campus-hero" aria-labelledby="home-heading">
 <div class="container-page">
  <div class="campus-hero-copy">
   <h1 id="home-heading">Useful tools for<br class="campus-display-break" /> everyday tasks</h1>
   <p class="hero-intro">Work with text, code, images, PDFs and calculations directly in your browser. Start with a focused collection, or search the full library.</p>
   <div class="hero-search-wrap">
    <label for="hero-search">What do you need to do?</label>
    <div class="hero-search-field"><Icon name="search" /><input id="hero-search" type="search" placeholder="Try word count, JSON or PDF…" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="hero-search-results" aria-autocomplete="list" /><a href="/tools/" class="hero-all-tools" aria-label="Browse all tools"><Icon name="arrow" /></a></div>
    <div id="hero-search-results" class="hidden hero-search-results" role="listbox" aria-label="Matching tools"></div>
   </div>
   <p class="hero-privacy">Tool inputs are processed in your browser. <a href="#local-processing">How processing and privacy work</a></p>
  </div>
  <div class="campus-task-strip">
   <div class="campus-photo"><Image src={stationery} alt="" width={2170} height={725} widths={[480,960,1440,2170]} sizes="(max-width: 767px) calc(100vw - 32px), (max-width: 1279px) calc(100vw - 288px), 944px" format="webp" quality={80} /></div>
   <details class="campus-quick-tasks"><summary>Start with a task <Icon name="chevron" /></summary><ul>{quickTasks.map(task=><li><a href={task.href}><strong>{task.label}</strong><small>{task.note}</small><Icon name="arrow" /></a></li>)}</ul></details>
  </div>
 </div>
</section>
<script>
  import { findSearchEntries, readSearchEntries } from "../helpers/search";
  import { createSearchResultStatusText } from "../helpers/utils";

  const input = document.getElementById("hero-search") as HTMLInputElement;
  const results = document.getElementById("hero-search-results");
  let activeIndex = -1;
  let activeLinks: HTMLAnchorElement[] = [];

  function clearResults() {
    if (!results) return;
    results.replaceChildren();
    results.classList.add("hidden");
    input?.setAttribute("aria-expanded", "false");
    input?.removeAttribute("aria-activedescendant");
    activeIndex = -1;
    activeLinks = [];
  }

  function setActiveIndex(index: number) {
    activeLinks.forEach((link, i) => {
      const isActive = i === index;
      link.setAttribute("aria-selected", String(isActive));
      link.classList.toggle("bg-canvas-soft-2", isActive);
    });
    activeIndex = index;
    if (activeLinks[index]) {
      input?.setAttribute("aria-activedescendant", activeLinks[index].id);
    } else {
      input?.removeAttribute("aria-activedescendant");
    }
  }

  function renderResults(query: string) {
    if (!results) return;
    const q = query.toLowerCase().trim();
    const matches = findSearchEntries(readSearchEntries(), q, {
      limit: 5, toolsOnly: true, includeKeywords: true,
    });

    results.replaceChildren();

    if (matches.length === 0) {
      const empty = document.createElement("div");
      empty.className = "px-4 py-3 text-sm text-mute";
      empty.textContent = createSearchResultStatusText(q);
      results.append(empty);
      activeLinks = [];
    } else {
      activeLinks = matches.map((tool, index) => {
        const link = document.createElement("a");
        link.href = tool.url;
        link.id = `hero-search-option-${index}`;
        link.role = "option";
        link.setAttribute("aria-selected", "false");
        link.className = "flex items-center gap-3 px-4 py-3 hover:bg-canvas-soft-2 transition-colors duration-100 no-underline";

        const icon = document.createElement("span");
        icon.className = "text-lg shrink-0";
        icon.textContent = tool.icon;

        const body = document.createElement("div");
        const name = document.createElement("div");
        name.className = "text-sm font-medium text-ink";
        name.textContent = tool.name;
        const description = document.createElement("div");
        description.className = "text-xs text-mute line-clamp-1";
        description.textContent = tool.description;

        body.append(name, description);
        link.append(icon, body);
        return link;
      });
      results.append(...activeLinks);
    }

    results.classList.remove("hidden");
    input?.setAttribute("aria-expanded", "true");
    setActiveIndex(activeLinks.length > 0 ? 0 : -1);
  }

  input?.addEventListener("input", (event) => {
    renderResults((event.target as HTMLInputElement).value);
  });
  input?.addEventListener("focus", () => renderResults(input.value));

  document.addEventListener("click", (event) => {
    if (!input?.contains(event.target as Node) && !results?.contains(event.target as Node)) {
      clearResults();
    }
  });

  input?.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      clearResults();
      input.blur();
      return;
    }
    if (results?.classList.contains("hidden") || activeLinks.length === 0) return;
    if (event.key === "ArrowDown") {
      event.preventDefault();
      setActiveIndex((activeIndex + 1) % activeLinks.length);
    } else if (event.key === "ArrowUp") {
      event.preventDefault();
      setActiveIndex((activeIndex - 1 + activeLinks.length) % activeLinks.length);
    } else if (event.key === "Enter" && activeIndex >= 0) {
      event.preventDefault();
      activeLinks[activeIndex].click();
    }
  });
</script>
