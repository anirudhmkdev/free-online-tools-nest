---
import Layout from "../layouts/Layout.astro";
import { SITE } from "../data/tools";
import { useTranslations, getDefaultAlternates } from "../i18n/utils";

const t = useTranslations("en");

const webPageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${SITE.url}/privacy-policy/`,
  name: t("privacy.metaTitle"),
  description: t("privacy.metaDesc"),
  url: `${SITE.url}/privacy-policy/`,
  isPartOf: {
    "@type": "WebSite",
    name: SITE.name,
    url: SITE.url,
  },
  author: {
    "@type": "Organization",
    name: "Free Online Tools Nest Team",
    url: "https://freeonlinetoolsnest.com/about/",
  },
  datePublished: "2026-01-15",
  dateModified: "2026-08-26",
};
---

<Layout
  title={t("privacy.metaTitle")}
  description={t("privacy.metaDesc")}
  canonicalPath="/privacy-policy/"
  alternatePaths={getDefaultAlternates("/privacy-policy/")}
  jsonLd={webPageJsonLd}
>
  <div class="container-narrow py-12 md:py-20">
    <h1 class="text-3xl md:text-4xl font-semibold text-ink mb-3" style="letter-spacing: -1.28px;">
      {t("privacy.title")}
    </h1>
    <p class="text-sm text-mute mb-10">{t("privacy.lastUpdated").replace("{date}", "August 26, 2026")}</p>

    <article class="space-y-6 text-body leading-relaxed">
      <section>
        <h2 class="text-xl font-semibold text-ink mb-3" style="letter-spacing: -0.6px;">{t("privacy.overviewTitle")}</h2>
        <p class="font-medium text-ink">
          {t("privacy.overviewP2")}
        </p>
        <p class="mt-3">
          {t("privacy.overviewP1").replace("{name}", SITE.name).replace("{domain}", SITE.domain)}
        </p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-ink mb-3" style="letter-spacing: -0.6px;">{t("privacy.dataProcessingTitle")}</h2>
        <p>
          {t("privacy.dataProcessingP1")}
        </p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-ink mb-3" style="letter-spacing: -0.6px;">{t("privacy.infoCollectTitle")}</h2>
        <p class="text-ink font-medium">{t("privacy.infoCollectP2")}</p>
        <p class="mt-3">{t("privacy.infoCollectP1")}</p>
        <ul class="list-disc pl-6 space-y-1 mt-2">
          <li>{t("privacy.infoCollectItem1")}</li>
          <li>{t("privacy.infoCollectItem2")}</li>
          <li>{t("privacy.infoCollectItem3")}</li>
        </ul>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-ink mb-3" style="letter-spacing: -0.6px;">{t("privacy.cookiesTitle")}</h2>
        <p>
          {t("privacy.cookiesP1")}
        </p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-ink mb-3" style="letter-spacing: -0.6px;">{t("privacy.localStorageTitle")}</h2>
        <p>
          {t("privacy.localStorageP1")}
        </p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-ink mb-3">Advertising, cookies, and consent</h2>
        <p>We use Google AdSense on selected content pages to support free access. Google and its advertising partners may use cookies, local storage, IP addresses, device information, and prior visits to this or other websites to serve, measure, and limit personalized or non-personalized ads.</p>
        <p class="mt-3">Where required, a Google-certified consent message lets you accept, reject, or manage advertising choices before personalized advertising is used. You can review or change ad personalization in <a class="text-link underline" href="https://adssettings.google.com/" target="_blank" rel="noopener noreferrer">Google Ads Settings</a> and learn about participating vendor opt-outs at <a class="text-link underline" href="https://optout.aboutads.info/" target="_blank" rel="noopener noreferrer">AboutAds</a>.</p>
        <p class="mt-3">Advertising does not receive the text, files, passwords, PDFs, images, or results you process inside our tools. Ads are kept separate from tool inputs, results, and download controls.</p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-ink mb-3" style="letter-spacing: -0.6px;">{t("privacy.thirdPartyTitle")}</h2>
        <p>
          {t("privacy.thirdPartyP1")} Google AdSense supplies and measures advertising on selected eligible pages; its vendors operate under their own privacy policies.
        </p>
        <p class="mt-3">
          {t("privacy.thirdPartyP2")}
        </p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-ink mb-3" style="letter-spacing: -0.6px;">{t("privacy.yourRightsTitle")}</h2>
        <p>
          {t("privacy.yourRightsP1")}
        </p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-ink mb-3" style="letter-spacing: -0.6px;">{t("privacy.contactTitle")}</h2>
        <p>
          {t("privacy.contactP1")}<a href="/contact/" class="text-link hover:text-link-deep underline">{t("footer.contact")}</a>.
        </p>
      </section>
    </article>
  </div>
</Layout>
