---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import { getToolBySlug, SITE } from "../data/tools";
import { getDefaultAlternates } from "../i18n/utils";
import { getCollection } from "astro:content";

const toolkits = [
  { id: "study-assignment-tools", label: "Student Tools", intro: "Plan attendance and grades using the rules and targets you enter.", tasks: [
    { slug: "attendance-calculator", purpose: "Check attendance and classes needed for your target." },
    { slug: "sgpa-calculator", purpose: "Calculate semester GPA with your credits and grade scale." },
    { slug: "cgpa-calculator", purpose: "Combine semesters using the weighting you choose." },
    { slug: "marks-percentage-calculator", purpose: "Calculate a percentage from subject marks and maxima." },
    { slug: "required-marks-calculator", purpose: "Find the remaining score needed for your overall target." },
    { slug: "word-counter", purpose: "Check the length of an assignment draft." },
    { slug: "qr-code-generator", purpose: "Make a QR code for a project or reference link." },
  ] },
  { id: "document-tools", label: "Assignment & Document Toolkit", intro: "Get the right pages, dimensions and file size for your submission.", tasks: [
    { slug: "image-to-pdf", purpose: "Turn JPEG and PNG assignment pages into one PDF." },
    { slug: "pdf-merger", purpose: "Combine PDFs into one document." },
    { slug: "pdf-splitter", purpose: "Keep only the pages you need." },
    { slug: "pdf-compressor", purpose: "Try reducing file size; savings depend on the PDF." },
    { slug: "pdf-to-text", purpose: "Extract selectable text. Scanned pages need OCR elsewhere." },
    { slug: "pdf-to-images", purpose: "Save PDF pages as images." },
    { slug: "image-compressor", purpose: "Adjust image encoding for a smaller upload." },
    { slug: "image-resizer", purpose: "Set the required pixel dimensions." },
    { slug: "image-cropper", purpose: "Remove unwanted edges from an image." },
  ] },
  { id: "writing-tools", label: "Writing Toolkit", intro: "Check length and common mistakes while keeping your draft local.", tasks: [
    { slug: "word-counter", purpose: "Count words and estimate reading time." },
    { slug: "character-counter", purpose: "Check character limits for applications and forms." },
    { slug: "grammar-checker", purpose: "Flag common English grammar patterns; review suggestions yourself." },
  ] },
];
const posts = await getCollection("blog");
const guideIds = ["why-pdfs-compress-differently", "image-compression-resizing-format-conversion", "verify-browser-tool-no-upload"];
const guides = guideIds.map(id => posts.find(post => post.id === id)!).filter(Boolean);
// JSON-LD structured data
const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: SITE.name,
  url: SITE.url,
  logo: `${SITE.url}/favicon-96x96.png`,
  description: SITE.description,
  sameAs: [
    "https://twitter.com/openProj3ct",
  ],
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "customer support",
    email: "openprojects50@gmail.com",
    url: "https://freeonlinetoolsnest.com/contact/",
  },
};

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  potentialAction: {
    "@type": "SearchAction",
    target: `${SITE.url}/tools/?q={search_term_string}`,
    "query-input": "required name=search_term_string",
  },
};
---

<Layout title="Student, Assignment & Document Tools" description="Calculate attendance, SGPA, CGPA and marks using your own inputs. Prepare assignments and turn images into PDFs locally in your browser, with no signup." canonicalPath="/" alternatePaths={getDefaultAlternates("/")} jsonLd={[websiteJsonLd, organizationJsonLd]} enableAds={true}>
  <Hero />
  <div class="container-page home-toolkit-sections">
    {toolkits.map(kit => (
      <section id={kit.id} class="toolkit-section" aria-labelledby={kit.id + "-heading"}>
        <div class="toolkit-heading"><h2 id={kit.id + "-heading"}>{kit.label}</h2><p>{kit.intro}</p></div>
        <ul class="task-list">
          {kit.tasks.map(task => {
            const tool = getToolBySlug(task.slug)!;
            return <li><a href={"/tools/" + tool.slug + "/"}><span><strong>{tool.name}</strong><span class="task-purpose">{task.purpose}</span></span><span class="task-arrow" aria-hidden="true">↗</span></a></li>;
          })}
        </ul>
      </section>
    ))}
    <div class="more-tools-note"><p>Looking for a developer utility, converter or another familiar tool?</p><a href="/tools/">Browse the full tool directory <span aria-hidden="true">→</span></a></div>
  </div>

  <section id="practical-guides" class="home-guides" aria-labelledby="guides-heading">
    <div class="container-page">
      <div class="section-heading"><div><p class="section-eyebrow">Understand the result</p><h2 id="guides-heading" class="section-title">Practical guides for your next upload</h2></div><a href="/blog/" class="pill-control">All articles</a></div>
      <div class="guide-list">{guides.map(post => <article><h3><a href={"/blog/" + post.id + "/"}>{post.data.title}</a></h3><p>{post.data.description}</p><a class="guide-read" href={"/blog/" + post.id + "/"} aria-label={"Read " + post.data.title}>Read guide <span aria-hidden="true">→</span></a></article>)}</div>
    </div>
  </section>

  <section id="local-processing" class="container-page home-trust" aria-labelledby="privacy-heading">
    <div><p class="section-eyebrow">Files stay in your workflow</p><h2 id="privacy-heading">Local processing, explained plainly.</h2></div>
    <div><p>These tools process the text and files you provide inside your browser, rather than sending them to a Free Online Tools Nest processing server. Large files can still be limited by your device's memory.</p><p>The website can make separate requests for fonts, Google Analytics and advertising. Local tool processing does not mean the entire page is disconnected from the internet.</p><a href="/privacy-policy/">Read the privacy policy</a></div>
  </section>
  <section class="container-page home-about" aria-label="Testing and about the site">
    <article><h2>How we test our tools</h2><p>Our review process covers example results, invalid inputs, file downloads and known limitations. Reviewed tools carry their recorded review date, and results still deserve a check before submission.</p><a href="/standards/">See our testing standards</a></article>
    <article><h2>About Free Online Tools Nest</h2><p>Small tasks should not stand between you and a finished assignment. We maintain browser utilities for study, writing and document preparation, alongside the wider collection.</p><a href="/about/">About the project</a><a href="/contact/">Report a problem</a></article>
  </section>
</Layout>

<style>
  .home-toolkit-sections { padding-top: 24px; }
  .toolkit-section { display: grid; grid-template-columns: minmax(220px, 1fr) minmax(0, 2fr); gap: 56px; padding: 40px 0; border-bottom: 1px solid var(--color-hairline); scroll-margin-top: 100px; }
  .toolkit-heading h2, .home-trust h2 { font-size: clamp(23px, 2.5vw, 29px); font-weight: 600; line-height: 1.25; letter-spacing: -0.5px; }
  .toolkit-heading p { margin-top: 14px; color: var(--color-body); font-size: 15px; line-height: 1.7; }
  .task-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px 24px; list-style: none; }
  .task-list a { display: flex; justify-content: space-between; gap: 12px; padding: 16px 12px; min-height: 100%; border-radius: 8px; text-decoration: none; color: var(--color-ink); }
  .task-list a:hover { background: var(--color-canvas-soft-2); }
  .task-list strong { font-size: 15px; font-weight: 500; }
  .task-purpose { display: block; margin-top: 6px; font-size: 13px; color: var(--color-body); line-height: 1.6; }
  .task-arrow { color: var(--color-link); }
  .more-tools-note { padding: 30px 0 44px; font-size: 14px; color: var(--color-body); display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
  .more-tools-note a, .home-trust a, .home-about a, .guide-read { color: var(--color-link); text-decoration: underline; text-underline-offset: 4px; }
  .home-guides { padding: 48px 0; border-block: 1px solid var(--color-hairline); background: var(--color-canvas); scroll-margin-top: 100px; }
  .guide-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  .guide-list h3 { font-size: 18px; font-weight: 500; line-height: 1.5; }
  .guide-list h3 a { color: var(--color-ink); text-decoration: none; }
  .guide-list h3 a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .guide-list p { margin: 12px 0 18px; color: var(--color-body); font-size: 14px; line-height: 1.7; }
  .guide-read { font-size: 14px; }
  .home-trust { display: grid; grid-template-columns: 1fr 2fr; gap: 56px; padding-top: 56px; padding-bottom: 40px; scroll-margin-top: 100px; }
  .home-trust p:not(.section-eyebrow), .home-about p { color: var(--color-body); line-height: 1.8; font-size: 15px; margin-bottom: 16px; }
  .home-trust a, .home-about a { display: inline-block; font-size: 14px; margin-right: 20px; min-height: 32px; }
  .home-about { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; padding-top: 24px; }
  .home-about h2 { font-size: 20px; font-weight: 500; margin-bottom: 14px; }
  @media (max-width: 800px) { .toolkit-section, .home-trust { grid-template-columns: 1fr; gap: 20px; } .guide-list { grid-template-columns: 1fr; gap: 28px; } .home-about { gap: 32px; } }
  @media (max-width: 540px) { .task-list, .home-about { grid-template-columns: 1fr; } .toolkit-section { padding: 32px 0; } .task-list a { padding-inline: 0; } }
</style>
