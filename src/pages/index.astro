---
/**
 * Homepage — hero, categories, featured tools, why choose us, FAQ, SEO content.
 */
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import CategoryCard from "../components/CategoryCard.astro";
import ToolCard from "../components/ToolCard.astro";
import FAQSection from "../components/FAQSection.astro";
import { CATEGORIES, getFeaturedTools, getToolsByCategory, SITE } from "../data/tools";
import { useTranslations, getDefaultAlternates } from "../i18n/utils";

const t = useTranslations("en");

const featuredPrioritySlugs = [
  "image-compressor",
  "json-formatter",
  "pdf-compressor",
  "pdf-merger",
  "word-counter",
  "qr-code-generator",
  "jwt-decoder",
  "epoch-converter",
  "word-cloud-generator",
  "grammar-checker",
  "random-number-generator",
  "color-palette-generator",
];
const featuredBySlug = new Map(getFeaturedTools().map((tool) => [tool.slug, tool]));
const featured = featuredPrioritySlugs
  .map((slug) => featuredBySlug.get(slug))
  .filter((tool) => tool !== undefined);


const homeFaqs = Array.from({ length: 7 }, (_, i) => {
  const n = i + 1;
  const answer = t(`home.faq.a${n}`);
  return {
    question: t(`home.faq.q${n}`),
    answer: answer.includes("{name}") ? answer.replace("{name}", SITE.name) : answer,
  };
});

// JSON-LD structured data
const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: SITE.name,
  url: SITE.url,
  logo: `${SITE.url}/favicon-96x96.png`,
  description: SITE.description,
  sameAs: [
    "https://twitter.com/openProj3ct",
  ],
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "customer support",
    email: "openprojects50@gmail.com",
    url: "https://freeonlinetoolsnest.com/contact/",
  },
};

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  potentialAction: {
    "@type": "SearchAction",
    target: `${SITE.url}/tools/?q={search_term_string}`,
    "query-input": "required name=search_term_string",
  },
};
---

<Layout
  title={t("home.metaTitle")}
  description={t("home.metaDesc")}
  canonicalPath="/"
  alternatePaths={getDefaultAlternates("/")}
  jsonLd={[websiteJsonLd, organizationJsonLd]}
  enableAds={true}
>
  <!-- Hero -->
  <Hero />


  <!-- Popular Workflows -->
  <section class="py-8 md:py-10 border-y border-hairline bg-canvas" aria-labelledby="popular-workflows-heading">
    <div class="container-page">
      <div class="section-heading">
        <div>
          <p class="section-eyebrow">Start fast</p>
          <h2 id="popular-workflows-heading" class="section-title">Popular workflows</h2>
          <p class="section-description">Jump into the tool clusters people use most for everyday browser-based work.</p>
        </div>
        <a href="/tools/" class="pill-control">View all tools</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4">
        <a href="/tools/image-compressor/" class="workflow-card group">
          <span class="workflow-card-label">Images</span>
          <span class="workflow-card-desc">Compress, crop, resize, and convert image files.</span>
          <span class="workflow-card-tools"><span>Image Compressor</span><span>Image Cropper</span><span>Image Resizer</span></span>
        </a>
        <a href="/tools/pdf-compressor/" class="workflow-card group">
          <span class="workflow-card-label">PDF</span>
          <span class="workflow-card-desc">Merge, split, compress, and extract PDF content.</span>
          <span class="workflow-card-tools"><span>PDF Compressor</span><span>PDF Merger</span><span>PDF to Text</span></span>
        </a>
        <a href="/tools/json-formatter/" class="workflow-card group">
          <span class="workflow-card-label">Code</span>
          <span class="workflow-card-desc">Format JSON, decode JWTs, test regex, and convert data.</span>
          <span class="workflow-card-tools"><span>JSON Formatter</span><span>JWT Decoder</span><span>Regex Tester</span></span>
        </a>
        <a href="/tools/word-counter/" class="workflow-card group">
          <span class="workflow-card-label">Writing</span>
          <span class="workflow-card-desc">Count, clean, compare, and polish text drafts.</span>
          <span class="workflow-card-tools"><span>Word Counter</span><span>Grammar Checker</span><span>Text Similarity</span></span>
        </a>
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="py-12 md:py-16" id="categories">
    <div class="container-page">
      <div class="section-heading">
        <div>
          <p class="section-eyebrow">7 categories</p>
          <h2 class="section-title">{t("home.browseByCategory")}</h2>
          <p class="section-description">
            {t("home.browseByCategoryDesc").replace("{count}", String(CATEGORIES.length))}
          </p>
        </div>
        <a href="/categories/" class="pill-control">Browse categories</a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {CATEGORIES.map((cat) => (
          <CategoryCard
            slug={cat.slug}
            name={cat.name}
            description={cat.description}
            icon={cat.icon}
            color={cat.color}
            toolCount={getToolsByCategory(cat.slug).length}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Tools -->
  <section class="py-12 md:py-16 bg-canvas" id="featured-tools">
    <div class="container-page">
      <div class="section-heading">
        <div>
          <p class="section-eyebrow">High-traffic tools</p>
          <h2 class="section-title">{t("home.popularTools")}</h2>
          <p class="section-description">{t("home.popularToolsDesc")}</p>
        </div>
        <a href="/tools/" class="pill-control">All 77 tools</a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {featured.map((tool) => (
          <ToolCard
            slug={tool.slug}
            name={tool.name}
            description={tool.description}
            icon={tool.icon}
            categorySlug={tool.categorySlug}
          />
        ))}
      </div>
      <div class="text-center mt-8">
        <a href="/tools/" class="btn-secondary">
          {t("home.viewAllTools")}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="inline ml-1">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
      </div>
    </div>
  </section>


  <!-- Why Choose Us -->
  <section class="py-12 md:py-16" id="why-us">
    <div class="container-page">
      <div class="section-heading">
        <div>
          <p class="section-eyebrow">Built for focus</p>
          <h2 class="section-title">{t("home.whyChoose")}</h2>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          {
            icon: "⚡",
            title: t("home.why1Title"),
            desc: t("home.why1Desc"),
          },
          {
            icon: "🔒",
            title: t("home.why2Title"),
            desc: t("home.why2Desc"),
          },
          {
            icon: "📱",
            title: t("home.why3Title"),
            desc: t("home.why3Desc"),
          },
        ].map((item) => (
          <div class="card p-6 text-center min-h-[180px]">
            <span class="text-3xl mb-4 block" aria-hidden="true">{item.icon}</span>
            <h3 class="text-lg font-semibold text-ink mb-2">{item.title}</h3>
            <p class="text-sm text-body leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <FAQSection items={homeFaqs} />

  <!-- SEO Content -->
  <section class="py-12 md:py-16 bg-canvas" id="about-section">
    <div class="container-narrow">
      <article class="prose-like">
        <h2 class="text-2xl md:text-3xl font-semibold text-ink mb-6" style="letter-spacing: -0.96px;">
          Free Online Tools Nest — Your Frontier Utilities Hub for Everyday Web Tasks
        </h2>

        <p class="text-body leading-relaxed mb-6">
          In today's fast-paced digital world, efficiency and convenience are key to maintaining a productive workflow. Whether you are a content writer perfecting a blog post, a developer formatting a complex JSON payload, a designer converting color codes, or a student solving a math problem,           having the right <strong>free browser-based tools</strong> at your fingertips makes all the difference. <strong>Free Online Tools Nest</strong> is a comprehensive collection of <strong>no signup tools</strong> and frontier utilities that addresses these everyday challenges.
        </p>

        <p class="text-body leading-relaxed mb-6">
          We provide a diverse suite of <strong>free online browser-based tools</strong> built around fast access, no signup, and local tool processing. Unlike platforms that require registrations, credit cards, or software installations, the utilities work directly inside your browser. Tool inputs are not sent to a Free Online Tools Nest processing server; analytics and advertising resources are described separately in our privacy policy.
        </p>

        <h3 class="text-xl font-semibold text-ink mt-8 mb-4" style="letter-spacing: -0.6px;">
          Why Choose Browser-Based Free Web Tools?
        </h3>

        <p class="text-body leading-relaxed mb-6">
          Traditional utility software can add friction through installers, updates, and license management. Many web-based alternatives also require files or text to be uploaded to remote servers, which may be unsuitable for private drafts or local documents.
        </p>

        <p class="text-body leading-relaxed mb-6">
          <strong>Free Online Tools Nest</strong> solves this by providing genuinely free web tools that leverage modern browser-based technology. When you use our platform, all calculations, formatting, and file processing occur locally on your machine using client-side JavaScript. This offers three critical benefits:
        </p>

        <ul class="list-disc pl-6 mb-6 space-y-2 text-body">
          <li><strong>Local tool processing</strong>: Tool input is not sent to our backend for processing, which reduces exposure compared with an upload-based workflow. Device security, browser extensions, clipboard history, and third-party page resources remain separate considerations.</li>
          <li><strong>Instant Speed</strong>: Without the need to transmit data back and forth across a network, results are processed in real-time. As you type, the tool outputs update instantly.</li>
          <li><strong>Local computation</strong>: Once the required code has loaded, many text and calculation workflows can continue without a processing-server round trip. Reloading pages and third-party resources still requires a network connection.</li>
        </ul>

        <h3 class="text-xl font-semibold text-ink mt-8 mb-4" style="letter-spacing: -0.6px;">
          A Curated Directory of Essential Tool Categories
        </h3>

        <p class="text-body leading-relaxed mb-6">
          Our platform organizes its <strong>web tools collection</strong> of frontier utilities into seven intuitive categories, making it easy to find the exact utility you need to optimize your daily productivity.
        </p>

        <h4 class="text-lg font-medium text-ink mt-6 mb-3">
          1. Developer Tools for Modern Workflows
        </h4>
        <p class="text-body leading-relaxed mb-4">
          Developers face daily formatting, encoding, and testing challenges. Our <strong>online developer tools</strong> category includes:
        </p>
        <ul class="list-disc pl-6 mb-6 space-y-1 text-body">
          <li><strong>JSON Formatter Online</strong>: A utility that beautifies minified JSON payloads, formats nested structures, and validates code by highlighting syntax errors and line numbers in real-time.</li>
          <li><strong>HTML Formatter Online</strong>: A fast utility to clean up messy HTML markups, customize indentation levels, and minify code for production performance.</li>
          <li><strong>URL Encoder Decoder Online</strong>: An instant tool to convert special characters in URLs to safe percent-encoded representations, or decode them back to human-readable strings.</li>
          <li><strong>Base64 Encoder Decoder Online</strong>: A secure encoder and decoder to translate binary or text data to and from Base64 format, ideal for data URIs, API request bodies, and email attachments.</li>
          <li><strong>Regex Tester Online</strong>: A sandbox to test and validate regular expressions against mock strings with real-time match highlighting and capture-group identification.</li>
        </ul>

        <h4 class="text-lg font-medium text-ink mt-6 mb-3">
          2. Text Tools for Writers and Content Creators
        </h4>
        <p class="text-body leading-relaxed mb-4">
          Creating well-formatted content requires precise tools. Our <strong>online text tools</strong> category provides:
        </p>
        <ul class="list-disc pl-6 mb-6 space-y-1 text-body">
          <li><strong>Word Counter Online</strong>: A robust analyzer that breaks down word count, sentences, paragraphs, and estimates reading times instantly.</li>
          <li><strong>Character Counter Online</strong>: A real-time character tracker that displays counts with and without spaces, perfect for writing Twitter posts, SMS, or Google meta descriptions.</li>
          <li><strong>Case Converter Online</strong>: A text transformer that converts input strings to UPPERCASE, lowercase, Title Case, Sentence case, or camelCase with one click.</li>
          <li><strong>Lorem Ipsum Generator Online</strong>: A placeholder dummy text creator that outputs custom word, sentence, or paragraph counts for design layouts and UI mockups.</li>
        </ul>

        <h4 class="text-lg font-medium text-ink mt-6 mb-3">
           3. Free Online Calculators for Instant Math
         </h4>
         <p class="text-body leading-relaxed mb-4">
           Complex equations shouldn't require opening a heavy spreadsheet or desktop application. Our <strong>free online calculators</strong> provide:
         </p>
         <ul class="list-disc pl-6 mb-6 space-y-1 text-body">
           <li><strong>Percentage Calculator Online</strong>: A multi-mode calculator to solve three distinct percentage math operations: finding a percentage of a number, determining what percentage one number is of another, and calculating the percentage change (increase or decrease) between two values.</li>
           <li><strong>Age Calculator Online</strong>: Calculate exact age from date of birth in years, months, weeks, days, hours, minutes, and seconds with support for any two-date comparison.</li>
           <li><strong>BMI Calculator Online</strong>: Compute Body Mass Index from height and weight with an interactive BMI scale, color-coded categories, and weight classification.</li>
           <li><strong>Tip Calculator Online</strong>: Calculate gratuity and split restaurant bills among any number of people with preset and custom tip percentages.</li>
           <li><strong>Date Difference Calculator</strong>: Find the exact duration between any two dates in years, months, weeks, and days for project planning and countdowns.</li>
           <li><strong>Number to Words Converter</strong>: Convert any number into its English word representation, perfect for writing checks and invoices.</li>
         </ul>

         <h4 class="text-lg font-medium text-ink mt-6 mb-3">
           4. PDF Tools for Document Processing
         </h4>
         <p class="text-body leading-relaxed mb-4">
           Work with PDF documents without installing desktop software. Our <strong>free online PDF tools</strong> run entirely in your browser:
         </p>
         <ul class="list-disc pl-6 mb-6 space-y-1 text-body">
           <li><strong>PDF Merger Online</strong>: Combine multiple PDF files into a single document with page reordering.</li>
           <li><strong>PDF Splitter Online</strong>: Split large PDFs into individual pages or extract specific page ranges.</li>
           <li><strong>PDF Compressor Online</strong>: Attempt to reduce PDF size by rewriting document structure locally, with savings depending on the source file.</li>
           <li><strong>PDF to Text Converter</strong>: Extract and copy text content from PDF documents with preserved formatting.</li>
           <li><strong>PDF to Image Converter</strong>: Convert PDF pages into high-quality PNG or JPEG images with custom quality settings.</li>
         </ul>

          <h4 class="text-lg font-medium text-ink mt-6 mb-3">
            5. Free Online SEO Tools for Content Optimization
          </h4>
          <p class="text-body leading-relaxed mb-4">
            Optimize your content for search engines without spending a dime. Our <strong>free online SEO tools</strong> help you audit, preview, and fine-tune every aspect of your on-page SEO:
          </p>
          <ul class="list-disc pl-6 mb-6 space-y-1 text-body">
            <li><strong>Meta Tag Generator Online</strong>: A complete wizard to generate title tags, meta descriptions, and Open Graph tags with character count validation and a real-time SERP preview.</li>
            <li><strong>Keyword Density Checker Online</strong>: Paste your content and instantly analyze keyword frequency and density distribution to avoid over-optimizing or missing key terms.</li>
            <li><strong>Robots.txt Generator Online</strong>: Create custom robots.txt files with a visual editor that supports allow and disallow rules, crawl delays, and sitemap references.</li>
            <li><strong>Sitemap Generator Online</strong>: Generate XML sitemaps from a list of URLs with customizable priority, changefreq settings, and lastmod dates.</li>
            <li><strong>SERP Preview Generator Online</strong>: Preview exactly how your page title and meta description will appear in Google search results before publishing.</li>
          </ul>

          <h4 class="text-lg font-medium text-ink mt-6 mb-3">
            6. Online Converter Tools for Seamless Formats
        </h4>
        <p class="text-body leading-relaxed mb-4">
          Convert files, strings, and values on the fly with our <strong>online converter tools</strong> suite:
        </p>
        <ul class="list-disc pl-6 mb-6 space-y-1 text-body">
          <li><strong>Online QR Code Generator</strong>: A tool that converts URLs, phone numbers, or plain text into downloadable, high-quality QR codes in PNG format for marketing campaigns and business cards.</li>
          <li><strong>Color Converter Online</strong>: A utility for designers and web developers to translate color codes seamlessly between HEX, RGB, and HSL formats with a live color preview box.</li>
          <li><strong>Markdown to HTML Converter</strong>: A tool that renders markdown syntax into clean, standard HTML code with a real-time side-by-side preview.</li>
          <li><strong>CSV to JSON Converter</strong>: A parser that transforms spreadsheet tables or raw CSV inputs into structured JSON arrays of objects, complete with delimiter configurations.</li>
          <li><strong>Image Compressor Online</strong>: A client-side optimizer that reduces file sizes for JPEG, PNG, and WebP images without uploading them to any server.</li>
        </ul>

        <h3 class="text-xl font-semibold text-ink mt-8 mb-4" style="letter-spacing: -0.6px;">
          How Our Frontier Utilities Streamline Your Work
        </h3>

        <p class="text-body leading-relaxed mb-6">
          By bringing these tools under a single, cohesive interface, <strong>Free Online Tools Nest</strong> provides a consistent place for common utility tasks. Advertising supports the free service, but it does not affect tool results and is kept separate from inputs, outputs, and download actions.
        </p>

        <p class="text-body leading-relaxed mb-6">
          Our <strong>free productivity tools</strong> and frontier utilities are designed with responsive layouts, ensuring that they work flawlessly on any screen size. Whether you are on a smartphone, a tablet, or a large desktop monitor, the layout adjusts to optimize screen space and usability. With keyboard navigation and accessible color contrasts, we ensure that every user can work comfortably and efficiently.
        </p>

        <h3 class="text-xl font-semibold text-ink mt-8 mb-4" style="letter-spacing: -0.6px;">How we maintain the collection</h3>
        <p class="text-body leading-relaxed">The team reviews tool behavior, browser compatibility, privacy claims, and documentation as the collection evolves. Our <a href="/standards/" class="text-link underline">editorial and testing standards</a> explain the checks used for reviewed tools and how to report a correction.</p>
      </article>
    </div>
  </section>
</Layout>
