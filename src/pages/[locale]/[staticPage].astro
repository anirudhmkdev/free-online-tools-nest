---
import Layout from "../../layouts/Layout.astro";
import { SITE } from "../../data/tools";
import { PUBLISHED_LOCALES } from "../../data/localized";
import { getDefaultAlternates } from "../../i18n/utils";
import type { Lang } from "../../i18n/ui";

const staticPages = ["about", "contact", "faq", "privacy-policy", "terms-and-conditions", "standards"] as const;
type StaticPage = (typeof staticPages)[number];

type PageCopy = {
  title: string;
  description: string;
  heading: string;
  intro: string;
  sections: { heading: string; body: string }[];
  cta?: { label: string; href: string };
};

