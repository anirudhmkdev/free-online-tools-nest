---
import CategoryPage from "../../../components/CategoryPage.astro";
import { PUBLISHED_LOCALES, getPublishedLocalizedCategorySlugs, hasLocalizedCategory } from "../../../data/localized";
import type { Lang } from "../../../i18n/ui";

export function getStaticPaths() {
  return PUBLISHED_LOCALES.flatMap((locale) =>
    getPublishedLocalizedCategorySlugs(locale).map((slug) => ({ params: { locale, slug } }))
  );
}

const lang = Astro.params.locale as Lang;
const slug = Astro.params.slug!;
const canonicalPath = `/${lang}/categories/${slug}/`;
const alternatePaths: Record<string, string> = { en: `/categories/${slug}/`, "x-default": `/categories/${slug}/` };
PUBLISHED_LOCALES.forEach((locale) => {
  if (hasLocalizedCategory(locale, slug)) alternatePaths[locale] = `/${locale}/categories/${slug}/`;
});
---

<CategoryPage
  categorySlug={slug}
  heading=""
  locale={lang}
  canonicalPath={canonicalPath}
  alternatePaths={alternatePaths}
/>
