---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  canonicalPath?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
import Layout from "./Layout.astro";
import { getPagePolicy } from "../data/page-policy";
const { title, description, pubDate, updatedDate, tags = [], canonicalPath, jsonLd } = Astro.props;
const review = canonicalPath ? getPagePolicy(canonicalPath) : undefined;
---

<Layout title={title} description={description} canonicalPath={canonicalPath} jsonLd={jsonLd} enableAds={true}>
  <article class="container-narrow py-12">
    <header class="mb-10">
      <h1 class="text-3xl md:text-4xl font-semibold text-ink" style="letter-spacing: -1.28px;">
        {title}
      </h1>
      <div class="mt-4 flex items-center gap-3 text-sm text-mute">
        <span>By <a href="/about/" class="text-link">Free Online Tools Nest Team</a></span>
        <span aria-hidden="true">·</span>
        <time datetime={pubDate.toISOString()}>
          {pubDate.toLocaleDateString("en-US", {
            year: "numeric", month: "long", day: "numeric",
          })}
        </time>
        {updatedDate && (
          <span>(Updated {updatedDate.toLocaleDateString("en-US", {
            year: "numeric", month: "long", day: "numeric",
          })})</span>
        )}
      </div>
      <p class="mt-3 text-xs text-mute">
        {review?.reviewStatus === "reviewed" && review.lastReviewed && <>Editorial review: <time datetime={review.lastReviewed}>{review.lastReviewed}</time> · </>}
        <a href="/standards/" class="text-link">Editorial and tool-testing standards</a>
      </p>
      {tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {tags.map(tag => (
            <span class="text-xs text-mute bg-canvas-soft-2 px-2.5 py-1 rounded-full">
              {tag}
            </span>
          ))}
        </div>
      )}
    </header>
    <div class="prose-like max-w-none">
      <slot />
    </div>
  </article>
</Layout>
